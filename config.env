# STARIZION SERVER CONFIGURATION
# IMPORTANT: Never commit this file to GitHub or expose it publicly.

PORT=5000
NODE_ENV=development

# Put your MongoDB Atlas URI here. Do not share the password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.uorslcr.mongodb.net/starizion?retryWrites=true&w=majority&appName=Cluster0

# Generate a long random value for production.
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Frontend URL(s)
CLIENT_ORIGIN=http://localhost:5173

# Email verification/reset configuration (optional until email is configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# If SMTP is not configured, development mode logs verification codes to the server console.
